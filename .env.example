# Copy to .env. Do not commit .env or API keys.

LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
VECTOR_STORE=memory

# Knowledge Source of Truth (JSON). Default uses committed fictional samples.
KNOWLEDGE_DIR=examples/sample_data

# Reports and SQLite live under DATA_DIR. SQLite is runtime state only.
DATA_DIR=data
DATABASE_URL=sqlite:///./data/runtime/piis.db

